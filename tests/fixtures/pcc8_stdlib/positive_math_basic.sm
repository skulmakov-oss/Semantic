fn main() {
    let root: f64 = sqrt(4.0);
    let root_repeat: f64 = sqrt(4.0);
    let magnitude: f64 = abs(0.0 - 3.5);
    let magnitude_positive: f64 = abs(3.5);
    let negative_root: f64 = sqrt(0.0 - 1.0);
    assert(root == 2.0);
    assert(root == root_repeat);
    assert(sqrt(9.0) == 3.0);
    assert(magnitude == 3.5);
    assert(magnitude_positive == 3.5);
    assert(negative_root != negative_root);
    return;
}
