fn classify(values: Sequence(i32)) -> bool {
    let mut traversal: i32 = 0;
    let mut count: i32 = 0;
    for value in values {
        traversal = traversal * 10 + value;
        count += 1;
    }
    return traversal == 24 && count == 3;
}

fn main() {
    let right: bool = classify([0, 2, 4]);
    assert(right == true);
    return;
}
