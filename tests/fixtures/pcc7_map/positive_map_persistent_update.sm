fn main() {
    let m: Map(i32, bool) = map_empty();
    let m2: Map(i32, bool) = map_set(m, 1, true);
    let m3: Map(i32, bool) = map_set(m2, 1, false);
    assert(map_get(m2, 1, false) == true);
    assert(map_get(m3, 1, true) == false);
    assert(map_contains(m3, 1) == true);
    assert(map_contains(m, 1) == false);
    return;
}
