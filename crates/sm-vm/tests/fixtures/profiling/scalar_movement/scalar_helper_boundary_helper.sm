fn helper_transform(index: i32) -> quad {
    let slot: i32 = index % 4;
    let state: quad = if slot == 0 {
        N
    } else {
        if slot == 1 {
            F
        } else {
            if slot == 2 {
                T
            } else {
                S
            }
        }
    };
    return state;
}

fn main() {
    let mut score: i32 = 0;
    let mut merged_count: i32 = 0;
    let mut checksum: i32 = 0;

    for i in 0..16 {
        let state: quad = helper_transform(i);
        let next: quad = helper_transform(i + 1);

        checksum += i;

        if state == N {
            score += 1;
        } else {
            if state == F {
                score += 2;
            } else {
                if state == T {
                    score += 3;
                } else {
                    score += 4;
                }
            }
        }

        if (state || next) == S {
            merged_count += 1;
        }
    }

    assert(score > 0);
    assert(merged_count > 0);
    assert(checksum == 120);
    return;
}
