fn classify_literal(x: u32) -> quad {
    let out: quad = match x {
        0u32 => { N }
        5u32 => { F }
        2147483647u32 => { T }
        2147483648u32 => { S }
        4294967295u32 => { T }
        _ => { N }
    };
    return out;
}

fn classify_range(x: u32) -> quad {
    let out: quad = match x {
        0..=0 => { N }
        5..=5 => { F }
        4294967295..=4294967295 => { T }
        _ => { S }
    };
    return out;
}

fn main() {
    assert(classify_literal(0u32) == N);
    assert(classify_literal(5u32) == F);
    assert(classify_literal(2147483647u32) == T);
    assert(classify_literal(2147483648u32) == S);
    assert(classify_literal(4294967295u32) == T);
    assert(classify_literal(1u32) == N);

    assert(classify_range(0u32) == N);
    assert(classify_range(5u32) == F);
    assert(classify_range(4294967295u32) == T);
    assert(classify_range(6u32) == S);
    return;
}
