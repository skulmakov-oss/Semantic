{
  "schema": "semantic.foundation.ssf11.corpus",
  "schema_version": 1,
  "purpose": "SSF-11 (#1582) canonical application conformance corpus: observable outcomes of the Rust Foundation toolchain, replayable later against a Bootstrap implementation. Not a stable-release claim.",
  "placeholders": {
    "{entry}": "entry_path resolved against the repository root",
    "{artifact}": "a fresh per-case temporary .smc path"
  },
  "observation_rules": [
    "exit status, diagnostic codes, verifier categories, runtime trap/quota identifiers, stdout bytes and written file bytes are comparable observations",
    "absolute paths, temp directories, timestamps and timing are never compared",
    "stderr expectations are substring checks of stable identifiers, not full-message snapshots",
    "Rust type names, struct layouts and private APIs are never part of an expectation"
  ],
  "families": [
    {
      "family_id": "F01",
      "title": "Minimal program",
      "disposition": "PASS-NEW",
      "contract_owner": "SSF-01 / SSF-10",
      "evidence_kind": "execution"
    },
    {
      "family_id": "F02",
      "title": "Quad decision engine",
      "disposition": "PASS-NEW",
      "contract_owner": "SSF-01",
      "evidence_kind": "execution"
    },
    {
      "family_id": "F03",
      "title": "Records / enums / Option / Result",
      "disposition": "PASS-NEW",
      "contract_owner": "SSF-01 / SSF-07",
      "evidence_kind": "execution"
    },
    {
      "family_id": "F04",
