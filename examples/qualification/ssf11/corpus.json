      "kind": "positive",
      "profile": "pure",
      "maturity": "Landed and qualified on `main`",
      "entry_path": "examples/qualification/ssf11/f01_minimal/main.sm",
      "contract_refs": [
        "docs/spec/source_semantics.md",
        "docs/spec/cli.md",
        "docs/spec/verifier.md",
        "docs/roadmap/stable_foundation/stable_public_language_contract.md"
      ],
      "steps": [
        {
          "args": [
            "check",
            "{entry}"
          ],
          "expected_exit": 0
        },
        {
          "args": [
            "compile",
            "{entry}",
            "-o",
            "{artifact}"
          ],
          "expected_exit": 0
        },
        {
          "args": [
            "verify",
            "{artifact}"
          ],
          "expected_exit": 0
        },
        {
          "args": [
            "run-smc",
            "{artifact}"
          ],
          "expected_exit": 0
        },
        {
          "args": [
            "run",
            "{entry}"
          ],
          "expected_exit": 0
        },
        {
          "args": [
            "artifact",
            "hash",
            "{artifact}"
          ],
          "expected_exit": 0,
          "stdout_regex": "^sha256:[0-9a-f]{64}\n$"
        }
      ],
      "expected_observable": "check/compile/verify/run-smc/run all exit 0; the in-program assert proves 1 + 1 == 2",
      "bootstrap_comparable": true,
      "qualification_role": "foundation+onboarding",
      "note": "The artifact-hash step checks the `sha256:<64 hex>` shape only. Byte-identical SemCode output is Foundation artifact-trust evidence (SSF-10), not a Bootstrap equivalence criterion."
