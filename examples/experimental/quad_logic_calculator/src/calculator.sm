fn quad_not(a: quad) -> quad {
    let result: quad = match a {
        N => { N }
        F => { T }
        T => { F }
        _ => { S }
    };
    return result;
}

fn quad_and(a: quad, b: quad) -> quad {
    let result: quad = match a {
        F => { F }
        T => {
            match b {
                F => { F }
                T => { T }
                N => { N }
                _ => { S }
            }
        }
        N => {
            match b {
                F => { F }
                T => { N }
                N => { N }
                _ => { S }
            }
        }
        _ => {
            match b {
                F => { F }
                _ => { S }
            }
        }
    };
    return result;
}

fn quad_or(a: quad, b: quad) -> quad {
    let result: quad = match a {
        T => { T }
        F => {
            match b {
                F => { F }
                T => { T }
                N => { N }
                _ => { S }
            }
        }
        N => {
            match b {
                T => { T }
                F => { N }
                N => { N }
                _ => { S }
            }
        }
        _ => {
            match b {
                T => { T }
                _ => { S }
            }
        }
    };
    return result;
}

fn quad_eval(op: i32, a: quad, b: quad) -> quad {
    let result: quad = match op {
        0 => { quad_and(a, b) }
        1 => { quad_or(a, b) }
        3 => { quad_not(a) }
        _ => { N }
    };
    return result;
}

fn main() {
    let result: quad = quad_eval(0, T, F);
    assert(result == F);
    return;
}