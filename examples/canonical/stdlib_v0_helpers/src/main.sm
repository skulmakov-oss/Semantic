fn build_values() -> Sequence(i32) {
    let mut values: Sequence(i32) = [2, 3];

    values = prepend(values, 1);
    values = push(values, 4);

    assert(len(values) == 4);
    assert(is_empty(values) == false);
    assert(contains(values, 3));

    return values;
}

fn sum_values(values: Sequence(i32)) -> i32 {
    let mut total: i32 = 0;

    for value in values {
        total = total + value;
    }

    return total;
}

fn pop_score() -> i32 {
    let mut values: Sequence(i32) = [1, 2, 3];

    values = pop(values);

    assert(len(values) == 2);
    assert(contains(values, 3) == false);

    return sum_values(values);
}

fn build_flags() -> Map(i32, bool) {
    let mut flags: Map(i32, bool) = map_empty();

    flags = map_set(flags, 1, true);
    flags = map_set(flags, 2, false);

    assert(map_contains(flags, 1));
    assert(map_contains(flags, 2));
    assert(map_get(flags, 1, false) == true);
    assert(map_get(flags, 2, true) == false);

    return flags;
}

fn score_flags(flags: Map(i32, bool)) -> i32 {
    let mut score: i32 = 0;

    if map_get(flags, 1, false) {
        score = score + 10;
    }

    if map_get(flags, 2, false) {
        score = score + 20;
    }

    return score;
}

fn build_report(total: i32, score: i32) -> text {
    let prefix: text = "stdlib-v0:";
    let separator: text = ":";

    return prefix + to_text(total) + separator + to_text(score);
}

fn option_score(value: Option(i32)) -> i32 {
    let score: i32 = match value {
        Option::Some(item) => { item }
        Option::None => { 0 }
        _ => { -100 }
    };
    return score;
}

fn result_score(value: Result(i32, i32)) -> i32 {
    let score: i32 = match value {
        Result::Ok(item) => { item }
        Result::Err(code) => { 0 - code }
        _ => { -100 }
    };
    return score;
}

fn assert_quad_truth_maps() {
    assert(qtruth_and(T, T) == T);
    assert(qtruth_or(F, F) == F);
    assert(qtruth_not(S) == S);
    assert(qtruth_impl(T, T) == S);
    return;
}

fn assert_math_helpers() {
    assert(sqrt(4.0) == 2.0);
    assert(sqrt(9.0) == 3.0);
    assert(abs(0.0 - 3.5) == 3.5);
    assert(abs(3.5) == 3.5);
    return;
}

fn assert_seeded_random_replay() {
    random_seed(7);
    let first: i32 = random_next_i32(-100, 100);
    let second: i32 = random_next_i32(-100, 100);

    random_seed(7);
    assert(random_next_i32(-100, 100) == first);
    assert(random_next_i32(-100, 100) == second);
    return;
}

fn main() {
    let values: Sequence(i32) = build_values();
    let flags: Map(i32, bool) = build_flags();

    let total: i32 = sum_values(values);
    let pop_total: i32 = pop_score();
    let score: i32 = score_flags(flags);

    assert(total == 10);
    assert(pop_total == 3);
    assert(score == 10);

    let report: text = build_report(total, score);

    assert(report == "stdlib-v0:10:10");
    assert(report != "");
    assert(option_score(Option::Some(5)) == 5);
    assert(option_score(Option::None) == 0);
    assert(result_score(Result::Ok(8)) == 8);
    assert(result_score(Result::Err(3)) == -3);
    assert_quad_truth_maps();
    assert_math_helpers();
    assert_seeded_random_replay();
    return;
}
